#!/bin/bash
clear

GREEN='\e[1;32m'
YELLOW='\e[1;33m'
CYAN='\e[1;36m'
RED='\e[1;31m'
NC='\e[0m'

echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${CYAN}             ⚙️  MENU TROJAN XRAY               ${NC}"
echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e " ${GREEN}[1]${NC} Tambah Akun TROJAN"
echo -e " ${GREEN}[2]${NC} 🎁 Trial TROJAN (1 Jam - Auto Username)"
echo -e " ${GREEN}[3]${NC} Hapus Akun TROJAN"
echo -e " ${GREEN}[4]${NC} Cek Login TROJAN"
echo -e " ${GREEN}[5]${NC} Perpanjang Masa Aktif"
echo -e " ${GREEN}[x]${NC} Kembali ke Menu Utama"
echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
read -rp "👉 Pilih opsi: " opt

case $opt in
    1) bash /etc/autoscriptvpn/xray/add-trojan.sh ;;
    2) bash /etc/autoscriptvpn/xray/trial-trojan.sh ;;
    3) bash /etc/autoscriptvpn/xray/del-trojan.sh ;;
    4) bash /etc/autoscriptvpn/xray/cek-trojan.sh ;;
    5) bash /etc/autoscriptvpn/xray/renew-trojan.sh ;;
    x) menu ;;
    *) echo -e "${RED}❌ Pilihan salah!${NC}"; sleep 1; m-trojan ;;
esac
