#!/bin/bash
clear

GREEN='\e[1;32m'
YELLOW='\e[1;33m'
CYAN='\e[1;36m'
RED='\e[1;31m'
NC='\e[0m'

echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${CYAN}             ⚙️  MENU VMESS XRAY               ${NC}"
echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e " ${GREEN}[1]${NC} Tambah Akun VMESS"
echo -e " ${GREEN}[2]${NC} 🎁 Trial VMESS (1 Jam - Auto Username)"
echo -e " ${GREEN}[3]${NC} Hapus Akun VMESS"
echo -e " ${GREEN}[4]${NC} Cek Login VMESS"
echo -e " ${GREEN}[5]${NC} Perpanjang Masa Aktif"
echo -e " ${GREEN}[x]${NC} Kembali ke Menu Utama"
echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
read -rp "👉 Pilih opsi: " opt

case $opt in
    1) bash /etc/AutoDANSC/xray/add-vmess.sh ;;
    2) bash /etc/AutoDANSC/xray/trial-vmess.sh ;;
    3) bash /etc/AutoDANSC/xray/del-vmess.sh ;;
    4) bash /etc/AutoDANSC/xray/cek-vmess.sh ;;
    5) bash /etc/AutoDANSC/xray/renew-vmess.sh ;;
    x) menu ;;
    *) echo -e "${RED}❌ Pilihan salah!${NC}"; sleep 1; m-vmess ;;
esac
