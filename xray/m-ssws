#!/bin/bash
clear

GREEN='\e[1;32m'
YELLOW='\e[1;33m'
CYAN='\e[1;36m'
RED='\e[1;31m'
NC='\e[0m'

echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${CYAN}              ⚙️  MENU SSH WS                  ${NC}"
echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e " ${GREEN}[1]${NC} Tambah Akun SSH"
echo -e " ${GREEN}[2]${NC} 🎁 Trial SSH (1 Jam - Auto Username)"
echo -e " ${GREEN}[3]${NC} Hapus Akun SSH"
echo -e " ${GREEN}[4]${NC} Cek Login SSH"
echo -e " ${GREEN}[5]${NC} Perpanjang Masa Aktif"
echo -e " ${GREEN}[6]${NC} List Semua Akun SSH"
echo -e " ${GREEN}[7]${NC} Hapus Akun Expired"
echo -e " ${GREEN}[8]${NC} Cek Status Layanan SSH"
echo -e " ${GREEN}[9]${NC} Restart Layanan SSH"
echo -e " ${GREEN}[x]${NC} Kembali ke Menu Utama"
echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
read -rp "👉 Pilih opsi: " opt

case $opt in
    1) bash /etc/autoscriptvpn/ssh/addssh.sh ;;
    2) bash /etc/autoscriptvpn/ssh/trial-ssh.sh ;;
    3) bash /etc/autoscriptvpn/ssh/delssh.sh ;;
    4) bash /etc/autoscriptvpn/ssh/cekssh.sh ;;
    5) bash /etc/autoscriptvpn/ssh/renewssh.sh ;;
    6) bash /etc/autoscriptvpn/ssh/listssh.sh ;;
    7) bash /etc/autoscriptvpn/ssh/expiredssh.sh ;;
    8) systemctl status ssh dropbear ws-dropbear ;;
    9) systemctl restart ssh dropbear ws-dropbear && echo -e "${GREEN}✅ Layanan SSH direstart${NC}" ;;
    x) menu ;;
    *) echo -e "${RED}❌ Pilihan salah!${NC}"; sleep 1; m-ssh ;;
esac
